# Contoh isi Secrets. JANGAN commit file secrets.toml yang asli.
# - Streamlit Cloud: paste baris di bawah ke Settings → Secrets
# - Lokal: salin file ini menjadi .streamlit/secrets.toml
#
# Pakai connection string "Session pooler" dari Supabase
# (Project → Connect → Session pooler), BUKAN "Direct connection",
# karena Streamlit Cloud tidak mendukung IPv6.

DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:PASSWORD_ANDA@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
